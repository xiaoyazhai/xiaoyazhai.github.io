{
  "name": "research-figure-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:showcase": "tsc --noEmit && vite build --mode showcase",
    "build:pages": "tsc --noEmit && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/live-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
